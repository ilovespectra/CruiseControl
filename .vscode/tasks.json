{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cruise: Open persistent developer console",
      "type": "process",
      "command": "python3",
      "args": ["scripts/dev-console.py", "--start"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Cruise: Run local checkout (no install)",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/run-local.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "runOptions": { "instanceLimit": 1 },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Cruise: Run Swift tests",
      "type": "shell",
      "command": "swift",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
